-av_cold int ff_v4l2_m2m_codec_init(V4L2m2mPriv *priv)
+typedef struct V4L2VideoNode {
+    char name[256];
+} V4L2VideoNode;
+
+/* video2 before video10: readdir() order is the file system's, not ours */
+static int v4l2_video_node_cmp(const void *a, const void *b)
+{
+    const char *na = ((const V4L2VideoNode *)a)->name;
+    const char *nb = ((const V4L2VideoNode *)b)->name;
+    long ia = strtol(na + 5, NULL, 10), ib = strtol(nb + 5, NULL, 10);
+
+    if (ia != ib)
+        return ia < ib ? -1 : 1;
+    return strcmp(na, nb);
+}
+
+/* The /dev/video* names, sorted; *nodes is av_free()d by the caller. */
+static int v4l2_list_video_nodes(V4L2VideoNode **nodes)
 {
-    int ret = AVERROR(EINVAL);
     struct dirent *entry;
+    int nb = 0, ret = 0;
     DIR *dirp;
 
-    V4L2m2mContext *s = priv->context;
-
+    *nodes = NULL;
     dirp = opendir("/dev");
     if (!dirp)
         return AVERROR(errno);
 
     for (entry = readdir(dirp); entry; entry = readdir(dirp)) {
+        V4L2VideoNode *tmp;
 
         if (strncmp(entry->d_name, "video", 5))
             continue;
-
-        snprintf(s->devname, sizeof(s->devname), "/dev/%s", entry->d_name);
-        av_log(s->avctx, AV_LOG_DEBUG, "probing device %s\n", s->devname);
-        ret = v4l2_probe_driver(s);
-        if (!ret)
+        tmp = av_realloc_array(*nodes, nb + 1, sizeof(**nodes));
+        if (!tmp) {
+            ret = AVERROR(ENOMEM);
             break;
+        }
+        *nodes = tmp;
+        snprintf((*nodes)[nb++].name, sizeof((*nodes)->name), "%s", entry->d_name);
     }
-
     closedir(dirp);
 
-    if (ret) {
-        av_log(s->avctx, AV_LOG_ERROR, "Could not find a valid device\n");
-        memset(s->devname, 0, sizeof(s->devname));
-
+    if (ret < 0) {
+        av_freep(nodes);
         return ret;
     }
+    if (nb)
+        qsort(*nodes, nb, sizeof(**nodes), v4l2_video_node_cmp);
+    return nb;
+}
+
+/*
+ * Whether /dev/@node is the one the "device" option names: by its node
+ * name (video3), its V4L2 device name (sysfs .../name, e.g. apple-ave1-enc),
+ * or its driver, card or bus_info as VIDIOC_QUERYCAP reports them.
+ */
+static int v4l2_device_matches(const char *node, const char *want)
+{
+    struct v4l2_capability cap;
+    char path[PATH_MAX], name[64] = "";
+    FILE *f;
+    int fd, ret;
+
+    if (!strcmp(node, want))
+        return 1;
+
+    snprintf(path, sizeof(path), "/sys/class/video4linux/%s/name", node);
+    f = fopen(path, "r");
+    if (f) {
+        if (fgets(name, sizeof(name), f))
+            name[strcspn(name, "\n")] = 0;
+        fclose(f);
+        if (!strcmp(name, want))
+            return 1;
+    }
+
+    snprintf(path, sizeof(path), "/dev/%s", node);
+    fd = open(path, O_RDWR | O_NONBLOCK, 0);
+    if (fd < 0)
+        return 0;
+    memset(&cap, 0, sizeof(cap));
+    ret = ioctl(fd, VIDIOC_QUERYCAP, &cap);
+    close(fd);
+    if (ret < 0)
+        return 0;
+
+    return !strcmp((const char *)cap.driver, want) ||
+           !strcmp((const char *)cap.card, want) ||
+           !strcmp((const char *)cap.bus_info, want);
+}
+
+av_cold int ff_v4l2_m2m_codec_init(V4L2m2mPriv *priv)
+{
+    int ret = AVERROR(EINVAL);
+    V4L2VideoNode *nodes = NULL;
+    int i, nb_nodes;
+
+    V4L2m2mContext *s = priv->context;
+    const char *want = priv->device && *priv->device ? priv->device : NULL;
+
+    if (want && strchr(want, '/')) {
+        /* a path: that device or none */
+        snprintf(s->devname, sizeof(s->devname), "%s", want);
+        av_log(s->avctx, AV_LOG_DEBUG, "probing device %s\n", s->devname);
+        ret = v4l2_probe_driver(s);
+        if (ret) {
+            av_log(s->avctx, AV_LOG_ERROR, "Device %s cannot be used for this (%s)\n",
+                   want, av_err2str(ret));
+            memset(s->devname, 0, sizeof(s->devname));
+            return ret;
+        }
+    } else {
+        nb_nodes = v4l2_list_video_nodes(&nodes);
+        if (nb_nodes < 0)
+            return nb_nodes;
+
+        for (i = 0; i < nb_nodes && ret; i++) {
+            if (want && !v4l2_device_matches(nodes[i].name, want))
+                continue;
+            snprintf(s->devname, sizeof(s->devname), "/dev/%s", nodes[i].name);
+            av_log(s->avctx, AV_LOG_DEBUG, "probing device %s\n", s->devname);
+            ret = v4l2_probe_driver(s);
+        }
+        av_free(nodes);
+
+        if (ret) {
+            if (want)
+                av_log(s->avctx, AV_LOG_ERROR, "No device matching '%s' can be used for this\n", want);
+            else
+                av_log(s->avctx, AV_LOG_ERROR, "Could not find a valid device\n");
+            memset(s->devname, 0, sizeof(s->devname));
+
+            return ret;
+        }
+    }
 
     av_log(s->avctx, AV_LOG_INFO, "Using device %s\n", s->devname);
 
