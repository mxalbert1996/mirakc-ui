+/*
+ * A packet from the device: put any header-only packet that came before
+ * it in front of it, and give it its DTS. AVERROR(EAGAIN): it was a
+ * header-only packet (drivers in V4L2_MPEG_VIDEO_HEADER_MODE_SEPARATE),
+ * kept for the next one, which is the frame's.
+ */
+static int v4l2_finish_packet(AVCodecContext *avctx, V4L2m2mContext *s, AVPacket *pkt)
+{
+    int64_t dts;
+    int ret;
+
+    if (!pkt->size) {
+        av_log(avctx, AV_LOG_ERROR, "The device returned an empty packet (a frame it could not code)\n");
+        return AVERROR(EIO);
+    }
+
+    if (!ff_v4l2_enc_has_picture(avctx->codec_id, pkt->data, pkt->size)) {
+        uint8_t *hdr;
+
+        if (pkt->size > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE - s->enc_hdr_size)
+            return AVERROR(ERANGE);
+        hdr = av_realloc(s->enc_hdr, s->enc_hdr_size + pkt->size);
+        if (!hdr)
+            return AVERROR(ENOMEM);
+        memcpy(hdr + s->enc_hdr_size, pkt->data, pkt->size);
+        s->enc_hdr       = hdr;
+        s->enc_hdr_size += pkt->size;
+        av_packet_unref(pkt);
+        return AVERROR(EAGAIN);
+    }
+
+    if (s->enc_hdr_size) {
+        const int size = pkt->size;
+
+        ret = av_grow_packet(pkt, s->enc_hdr_size);
+        if (ret < 0)
+            return ret;
+        memmove(pkt->data + s->enc_hdr_size, pkt->data, size);
+        memcpy(pkt->data, s->enc_hdr, s->enc_hdr_size);
+        s->enc_hdr_size = 0;
+    }
+
+    ret = ff_v4l2_enc_ts_next_dts(&s->ts, &dts);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_WARNING, "The device returned more packets than it was given frames\n");
+        dts = pkt->pts;
+    }
+
+    if (avctx->max_b_frames <= 0) {
+        pkt->dts = pkt->pts;
+    } else {
+        pkt->dts = dts;
+        if (pkt->pts != AV_NOPTS_VALUE && dts != AV_NOPTS_VALUE && dts > pkt->pts)
+            av_log(avctx, AV_LOG_WARNING, "DTS %"PRId64" > PTS %"PRId64": the device "
+                   "reorders by more than %d frame(s)\n", dts, pkt->pts, avctx->max_b_frames);
+    }
