+/*
+ * Constant QP: frame-level rate control off, so that the I/P/B QP controls
+ * apply (and the CQ bitrate mode for drivers that look at that instead).
+ */
+static int v4l2_set_constant_qp(V4L2m2mContext *s, int qp)
+{
+    AVCodecContext *avctx = s->avctx;
+    V4L2m2mPriv *priv = s->priv;
+    const struct v4l2_qp_ctrls *c = NULL;
+    int i, qp_i, qp_p, qp_b;
+
+    /* The QP ctrls are generic V4L2 controls, but only AVE implements them. */
+    if (!s->is_apple_ave) {
+        av_log(avctx, AV_LOG_ERROR, "Constant QP is only implemented for Apple AVE\n");
+        return AVERROR(ENOSYS);
+    }
+
+    for (i = 0; i < FF_ARRAY_ELEMS(v4l2_qp_ctrls); i++)
+        if (v4l2_qp_ctrls[i].codec_id == avctx->codec_id)
+            c = &v4l2_qp_ctrls[i];
+    if (!c) {
+        av_log(avctx, AV_LOG_ERROR, "Constant QP is not supported for %s\n",
+               avcodec_get_name(avctx->codec_id));
+        return AVERROR(ENOSYS);
+    }
+
+    qp_i = av_clip(qp, c->min, c->max);
+    qp_p = av_clip(qp_i + priv->qp_p_offset, c->min, c->max);
+    qp_b = av_clip(qp_i + priv->qp_b_offset, c->min, c->max);
+    if (qp_i != qp)
+        av_log(avctx, AV_LOG_WARNING, "QP %d out of range, using %d\n", qp, qp_i);
+
+    v4l2_set_ext_ctrl(s, MPEG_CID(FRAME_RC_ENABLE), 0, "frame level rate control", 1);
+    v4l2_set_ext_ctrl(s, MPEG_CID(BITRATE_MODE), MPEG_VIDEO(BITRATE_MODE_CQ),
+                      "constant quality bitrate mode", 0);
+    v4l2_set_ext_ctrl(s, c->i_cid, qp_i, "I-frame QP", 1);
+    v4l2_set_ext_ctrl(s, c->p_cid, qp_p, "P-frame QP", 1);
+    if (c->b_cid)
+        v4l2_set_ext_ctrl(s, c->b_cid, qp_b, "B-frame QP", avctx->max_b_frames > 0);
+
+    av_log(avctx, AV_LOG_VERBOSE, "Constant QP: I %d, P %d, B %d\n", qp_i, qp_p, qp_b);
+    s->enc_qp[0] = qp_i;
+    s->enc_qp[1] = qp_p;
+    s->enc_qp[2] = qp_b;
+
+    return 0;
 }
 
