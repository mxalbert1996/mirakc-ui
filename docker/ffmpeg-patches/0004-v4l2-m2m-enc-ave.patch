+/* How long to wait for the last packets once the device sent its EOS event. */
+#define V4L2_ENC_EOS_WAIT_MS 2000
+/* Wake-ups without a packet in a row that mean the device has stopped. */
+#define V4L2_ENC_MAX_IDLE    100
+
+static int v4l2_receive_packet_ave(AVCodecContext *avctx, AVPacket *avpkt)
+{
+    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+    V4L2Context *const capture = &s->capture;
+    int ret, idle = 0;
+
+    for (;;) {
+        int pending = 0, timeout;
+
+        if (!s->draining) {
+            ret = v4l2_queue_input(avctx, s);
+            if (ret < 0)
+                return ret;
+            pending = !!s->frame->buf[0];
+        }
+
+        if (s->draining) {
+            if (!capture->streamon)
+                return AVERROR_EOF;
+            timeout = V4L2_ENC_EOS_WAIT_MS;
+        } else if (pending || ff_v4l2_enc_ts_in_flight(&s->ts) > s->enc_hold) {
+            /*
+             * The device has more frames than it may keep back (the B frames
+             * it holds until their reference arrives, and one being coded):
+             * a packet will come. Or the frame waits for room on the OUTPUT
+             * queue, which a packet or a returned OUTPUT buffer gives.
+             */
+            timeout = -1;
+        } else {
+            /* it may be keeping every frame it has until it gets more */
+            timeout = 0;
+        }
+
+        ret = ff_v4l2_context_dequeue_packet(capture, avpkt, timeout, pending);
+        if (ret == AVERROR(EAGAIN)) {
+            if (!timeout)
+                return AVERROR(EAGAIN);
+            if (pending)
+                continue;
+            if (s->draining) {
+                av_log(avctx, AV_LOG_WARNING, "No last packet from the device during drain\n");
+                capture->done = 1;
+                return AVERROR_EOF;
+            }
+            if (++idle > V4L2_ENC_MAX_IDLE) {
+                av_log(avctx, AV_LOG_ERROR, "The device stopped returning packets\n");
+                return AVERROR(EIO);
+            }
+            continue;
+        }
+        if (ret < 0)
+            return ret;
+
+        ret = v4l2_finish_packet(avctx, s, avpkt);
+        if (ret == AVERROR(EAGAIN))
+            continue;
+        if (ret < 0)
+            av_packet_unref(avpkt);
+        return ret;
+    }
+}
