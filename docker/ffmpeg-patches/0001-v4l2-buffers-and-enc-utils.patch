+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+
+#include "libavutil/common.h"
+#include "libavutil/error.h"
+#include "libavutil/fifo.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+
+#include "defs.h"
+#include "v4l2_enc_utils.h"
+
+#define V4L2_ENC_MAX_PLANES 4
+
+typedef struct V4L2EncPlane {
+    uint8_t *data;
+    int stride;     /* bytes from one line to the next */
+    int rows;       /* lines in the format */
+    int bytes;      /* bytes of a line that the format's width covers */
+    int group;      /* bytes of one sample position (0: do not pad columns) */
+} V4L2EncPlane;
+
+static int plane_components(const AVPixFmtDescriptor *desc, int plane)
+{
+    int i, n = 0;
+
+    for (i = 0; i < desc->nb_components; i++)
+        n += desc->comp[i].plane == plane;
+    return n;
+}
+
+static int is_chroma_plane(int plane)
+{
+    return plane == 1 || plane == 2;
+}
+
+static int v4l2_enc_layout(enum AVPixelFormat fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int width, int height,
+                           V4L2EncPlane pl[V4L2_ENC_MAX_PLANES],
+                           size_t bytesused[])
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(fmt);
+    int nb_planes = av_pix_fmt_count_planes(fmt);
+    size_t offset = 0;
+    int p;
+
+    if (!desc || (desc->flags & AV_PIX_FMT_FLAG_HWACCEL) ||
+        nb_planes <= 0 || nb_planes > V4L2_ENC_MAX_PLANES ||
+        width <= 0 || height <= 0)
+        return AVERROR(EINVAL);
+    if (nb_mem_planes != 1 && nb_mem_planes != nb_planes)
+        return AVERROR(EINVAL);
+
+    for (p = 0; p < nb_planes; p++) {
+        const int mp = nb_mem_planes > 1 ? p : 0;
+        const int chroma = is_chroma_plane(p);
+        int stride, bytes = av_image_get_linesize(fmt, width, p);
+
+        if (bytes < 0)
+            return bytes;
+
+        if (nb_mem_planes > 1) {
+            offset = 0;
+            stride = bytesperline[mp] > 0 ? bytesperline[mp] : bytes;
+        } else if (p == 0) {
+            stride = bytesperline[0] > 0 ? bytesperline[0] : bytes;
+        } else {
+            /*
+             * A plane that follows plane 0 in the same memory: its line
+             * length follows from plane 0's as the V4L2 specification
+             * derives it (NV12: the same, YUV420: half, P010: the same).
+             */
+            const int luma = bytesperline[0] > 0 ? bytesperline[0] :
+                             av_image_get_linesize(fmt, width, 0);
+            stride = (int)(((int64_t)luma * plane_components(desc, p) /
+                            FFMAX(plane_components(desc, 0), 1)) >>
+                           (chroma ? desc->log2_chroma_w : 0));
+        }
+        if (stride < bytes)
+            return AVERROR(EINVAL);
+
+        pl[p].data   = dst[mp] + offset;
+        pl[p].stride = stride;
+        pl[p].rows   = chroma ? AV_CEIL_RSHIFT(height, desc->log2_chroma_h) : height;
+        pl[p].bytes  = bytes;
+        pl[p].group  = nb_planes > 1 ?
+                       av_image_get_linesize(fmt, chroma ? 1 << desc->log2_chroma_w : 1, p) : 0;
+
+        if (offset > dst_len[mp] ||
+            (size_t)pl[p].stride * pl[p].rows > dst_len[mp] - offset)
+            return AVERROR(ENOSPC);
+
+        offset += (size_t)pl[p].stride * pl[p].rows;
+        bytesused[mp] = offset;
+    }
+
+    return nb_planes;
+}
+
+/* Repeat the last column and line of the picture into the format's padding. */
+static void v4l2_enc_pad_plane(const V4L2EncPlane *pl, int vis_bytes, int vis_rows)
+{
+    int x, y;
+
+    if (vis_rows <= 0 || vis_bytes <= 0)
+        return;
+
+    if (pl->group > 0 && vis_bytes >= pl->group && vis_bytes < pl->bytes) {
+        for (y = 0; y < vis_rows; y++) {
+            uint8_t *row = pl->data + (size_t)y * pl->stride;
+            const uint8_t *last = row + vis_bytes - pl->group;
+
+            for (x = vis_bytes; x + pl->group <= pl->bytes; x += pl->group)
+                memcpy(row + x, last, pl->group);
+        }
+    }
+
+    for (y = vis_rows; y < pl->rows; y++)
+        memcpy(pl->data + (size_t)y * pl->stride,
+               pl->data + (size_t)(vis_rows - 1) * pl->stride, pl->bytes);
+}
+
+int ff_v4l2_enc_can_convert(enum AVPixelFormat src, enum AVPixelFormat dst)
+{
+    if (src == dst)
+        return 1;
+    switch (src) {
+    case AV_PIX_FMT_YUV420P:
+        return dst == AV_PIX_FMT_NV12 || dst == AV_PIX_FMT_NV21;
+    case AV_PIX_FMT_YUV420P10LE:
+        return dst == AV_PIX_FMT_P010LE;
+    default:
+        return 0;
+    }
+}
+
+enum AVPixelFormat ff_v4l2_enc_request_fmt(enum AVPixelFormat src)
+{
+    /* 10-bit 4:2:0 has no V4L2 format of its own; P010 holds it as is */
+    return src == AV_PIX_FMT_YUV420P10LE ? AV_PIX_FMT_P010LE : src;
+}
+
+/* Planar 4:2:0 into the semi-planar layout: the same luma, interleaved chroma. */
+static void v4l2_enc_convert(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                             const V4L2EncPlane pl[], int w, int h)
+{
+    const int cw = AV_CEIL_RSHIFT(w, 1), ch = AV_CEIL_RSHIFT(h, 1);
+    const int swap = dst_fmt == AV_PIX_FMT_NV21;
+    int x, y;
+
+    if (dst_fmt == AV_PIX_FMT_P010LE) {
+        /* P010: the 10 bits sit at the top of each 16-bit sample */
+        for (y = 0; y < h; y++) {
+            const uint8_t *s = src->data[0] + (ptrdiff_t)y * src->linesize[0];
+            uint8_t *d = pl[0].data + (size_t)y * pl[0].stride;
+
+            for (x = 0; x < w; x++)
+                AV_WL16(d + 2 * x, AV_RL16(s + 2 * x) << 6);
+        }
+        for (y = 0; y < ch; y++) {
+            const uint8_t *u = src->data[1] + (ptrdiff_t)y * src->linesize[1];
+            const uint8_t *v = src->data[2] + (ptrdiff_t)y * src->linesize[2];
+            uint8_t *d = pl[1].data + (size_t)y * pl[1].stride;
+
+            for (x = 0; x < cw; x++) {
+                AV_WL16(d + 4 * x,     AV_RL16(u + 2 * x) << 6);
+                AV_WL16(d + 4 * x + 2, AV_RL16(v + 2 * x) << 6);
+            }
+        }
+        return;
+    }
+
+    av_image_copy_plane(pl[0].data, pl[0].stride, src->data[0], src->linesize[0], w, h);
+    for (y = 0; y < ch; y++) {
+        const uint8_t *u = src->data[swap ? 2 : 1] + (ptrdiff_t)y * src->linesize[swap ? 2 : 1];
+        const uint8_t *v = src->data[swap ? 1 : 2] + (ptrdiff_t)y * src->linesize[swap ? 1 : 2];
+        uint8_t *d = pl[1].data + (size_t)y * pl[1].stride;
+
+        for (x = 0; x < cw; x++) {
+            d[2 * x]     = u[x];
+            d[2 * x + 1] = v[x];
+        }
+    }
+}
+
+int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int fmt_width, int fmt_height, size_t bytesused[])
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(dst_fmt);
+    V4L2EncPlane pl[V4L2_ENC_MAX_PLANES];
+    const int w = FFMIN(src->width,  fmt_width);
+    const int h = FFMIN(src->height, fmt_height);
+    const int convert = src->format != dst_fmt;
+    int p, nb_planes;
+
+    if (!ff_v4l2_enc_can_convert(src->format, dst_fmt) || w <= 0 || h <= 0)
+        return AVERROR(EINVAL);
+
+    nb_planes = v4l2_enc_layout(dst_fmt, dst, dst_len, bytesperline,
+                                nb_mem_planes, fmt_width, fmt_height,
+                                pl, bytesused);
+    if (nb_planes < 0)
+        return nb_planes;
+
+    if (convert) {
+        if (!src->data[0] || !src->data[1] || !src->data[2])
+            return AVERROR(EINVAL);
+        v4l2_enc_convert(src, dst_fmt, pl, w, h);
+    }
+
+    for (p = 0; p < nb_planes; p++) {
+        const int rows  = is_chroma_plane(p) ? AV_CEIL_RSHIFT(h, desc->log2_chroma_h) : h;
+        const int bytes = av_image_get_linesize(dst_fmt, w, p);
+
+        if (bytes < 0)
+            return AVERROR(EINVAL);
+
+        if (!convert) {
+            if (!src->data[p])
+                return AVERROR(EINVAL);
+            av_image_copy_plane(pl[p].data, pl[p].stride,
+                                src->data[p], src->linesize[p], bytes, rows);
+        }
+        v4l2_enc_pad_plane(&pl[p], bytes, rows);
+    }
+
+    return 0;
+}
+
+/*
+ * Timestamps of a device that reorders: frames go in in presentation
+ * order, packets come out in decode order, each with its own frame's PTS.
+ */
+int ff_v4l2_enc_ts_init(V4L2EncTimestamps *ts, int delay, int64_t step)
+{
+    ff_v4l2_enc_ts_uninit(ts);
+    ts->pts = av_fifo_alloc2(16, sizeof(int64_t), AV_FIFO_FLAG_AUTO_GROW);
+    if (!ts->pts)
+        return AVERROR(ENOMEM);
+    ts->delay = FFMAX(delay, 0);
+    ts->step  = FFMAX(step, 1);
+    return 0;
+}
+
+void ff_v4l2_enc_ts_uninit(V4L2EncTimestamps *ts)
+{
+    av_fifo_freep2(&ts->pts);
+    ts->nb_in = ts->nb_out = 0;
+}
+
+int ff_v4l2_enc_ts_push(V4L2EncTimestamps *ts, int64_t pts)
+{
+    int ret = av_fifo_write(ts->pts, &pts, 1);
+
+    if (ret < 0)
+        return ret;
+    ts->nb_in++;
+    return 0;
+}
+
+int ff_v4l2_enc_ts_next_dts(V4L2EncTimestamps *ts, int64_t *dts)
+{
+    int64_t pts;
+    int ret;
+
+    /*
+     * Packet n gets the PTS of frame n - delay. With at most `delay` frames
+     * between a frame's position in presentation order and its position in
+     * decode order, that is never later than the packet's own PTS, and it
+     * rises with n. The first `delay` packets have no such frame: they get
+     * the first PTS minus whole frame durations.
+     */
+    if (ts->nb_out < ts->delay) {
+        ret = av_fifo_peek(ts->pts, &pts, 1, 0);
+        if (ret < 0)
+            return ret;
+        *dts = pts == AV_NOPTS_VALUE ? AV_NOPTS_VALUE :
+               pts - (ts->delay - ts->nb_out) * ts->step;
+    } else {
+        ret = av_fifo_read(ts->pts, &pts, 1);
+        if (ret < 0)
+            return ret;
+        *dts = pts;
+    }
+    ts->nb_out++;
+    return 0;
+}
+
+/* The next Annex B start code (00 00 01) at or after p, or end. */
+static const uint8_t *v4l2_enc_find_startcode(const uint8_t *p, const uint8_t *end)
+{
+    for (; end - p >= 3; p++)
+        if (!p[0] && !p[1] && p[2] == 1)
+            return p;
+    return end;
+}
+
+/*
+ * Call cb for every NAL unit of an Annex B buffer; nal points at the NAL
+ * header, size excludes the start code and any trailing zero bytes. Stops
+ * when cb returns non-zero and returns that value.
+ */
+static int v4l2_enc_for_each_nal(const uint8_t *data, int size,
+                                 int (*cb)(void *opaque, const uint8_t *nal, int size),
+                                 void *opaque)
+{
+    const uint8_t *end = data + size;
+    const uint8_t *sc = v4l2_enc_find_startcode(data, end);
+
+    while (sc < end) {
+        const uint8_t *nal  = sc + 3;
+        const uint8_t *next = v4l2_enc_find_startcode(nal, end);
+        const uint8_t *nend = next;
+        int ret;
+
+        while (nend > nal && !nend[-1])
+            nend--;
+        if (nend > nal) {
+            ret = cb(opaque, nal, nend - nal);
+            if (ret)
+                return ret;
+        }
+        sc = next;
+    }
+    return 0;
+}
+
+static int v4l2_enc_nal_type(enum AVCodecID codec_id, const uint8_t *nal)
+{
+    return codec_id == AV_CODEC_ID_HEVC ? (nal[0] >> 1) & 0x3f : nal[0] & 0x1f;
+}
+
+static int v4l2_enc_is_vcl(enum AVCodecID codec_id, int type)
+{
+    return codec_id == AV_CODEC_ID_HEVC ? type < 32 : type >= 1 && type <= 5;
+}
+
+typedef struct V4L2EncNalScan {
+    enum AVCodecID codec_id;
+} V4L2EncNalScan;
+
+static int v4l2_enc_vcl_cb(void *opaque, const uint8_t *nal, int size)
+{
+    const V4L2EncNalScan *scan = opaque;
+
+    return v4l2_enc_is_vcl(scan->codec_id, v4l2_enc_nal_type(scan->codec_id, nal));
+}
+
+int ff_v4l2_enc_has_picture(enum AVCodecID codec_id, const uint8_t *data, int size)
+{
+    V4L2EncNalScan scan = { codec_id };
+
+    if (codec_id != AV_CODEC_ID_H264 && codec_id != AV_CODEC_ID_HEVC)
+        return 1;
+    return v4l2_enc_for_each_nal(data, size, v4l2_enc_vcl_cb, &scan);
+}
+
+typedef struct V4L2EncParamSets {
+    enum AVCodecID codec_id;
+    uint8_t *buf;
+    int size;
+    unsigned seen;      /* bit per NAL unit type found */
+    int err;
+} V4L2EncParamSets;
+
+static int v4l2_enc_paramset_cb(void *opaque, const uint8_t *nal, int size)
+{
+    static const uint8_t startcode[4] = { 0, 0, 0, 1 };
+    V4L2EncParamSets *ps = opaque;
+    const int type = v4l2_enc_nal_type(ps->codec_id, nal);
+    const int keep = ps->codec_id == AV_CODEC_ID_HEVC ?
+                     type >= 32 && type <= 34 :             /* VPS, SPS, PPS */
+                     type == 7 || type == 8 || type == 13;  /* SPS, PPS, SPS extension */
+    uint8_t *buf;
+
+    if (v4l2_enc_is_vcl(ps->codec_id, type))
+        return 1;       /* the parameter sets come before the picture */
+    if (!keep)
+        return 0;
+    if (size > INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE - 4 - ps->size) {
+        ps->err = AVERROR(ERANGE);
+        return 1;
+    }
+    buf = av_realloc(ps->buf, ps->size + 4 + size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!buf) {
+        ps->err = AVERROR(ENOMEM);
+        return 1;
+    }
+    memcpy(buf + ps->size, startcode, 4);
+    memcpy(buf + ps->size + 4, nal, size);
+    ps->buf   = buf;
+    ps->size += 4 + size;
+    memset(ps->buf + ps->size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    ps->seen |= 1u << (type & 31);
+    return 0;
+}
+
+int ff_v4l2_enc_extract_paramsets(enum AVCodecID codec_id, const uint8_t *data, int size,
+                                  uint8_t **out, int *out_size)
+{
+    V4L2EncParamSets ps = { codec_id };
+    unsigned need;
+
+    if (codec_id == AV_CODEC_ID_HEVC)
+        need = 1u << (32 & 31) | 1u << (33 & 31) | 1u << (34 & 31);
+    else if (codec_id == AV_CODEC_ID_H264)
+        need = 1u << 7 | 1u << 8;
+    else
+        return AVERROR(ENOSYS);
+
+    v4l2_enc_for_each_nal(data, size, v4l2_enc_paramset_cb, &ps);
+    if (ps.err < 0 || (ps.seen & need) != need) {
+        av_free(ps.buf);
+        return ps.err < 0 ? ps.err : AVERROR_INVALIDDATA;
+    }
+    *out      = ps.buf;
+    *out_size = ps.size;
+    return 0;
+}
diff --git a/libavcodec/v4l2_enc_utils.h b/libavcodec/v4l2_enc_utils.h
new file mode 100644
index 0000000..2a2129d
--- /dev/null
+++ b/libavcodec/v4l2_enc_utils.h
@@ -0,0 +1,132 @@
+/*
+ * V4L2 mem2mem encoder helpers that do not touch the device
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_V4L2_ENC_UTILS_H
+#define AVCODEC_V4L2_ENC_UTILS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/pixfmt.h"
+
+#include "codec_id.h"
+
+struct AVFifo;
+
+/**
+ * @return 1 if ff_v4l2_enc_copy_frame() can copy a frame of format src into
+ *         a buffer of format dst (the same format, or planar 4:2:0 into
+ *         NV12/NV21/P010), 0 otherwise
+ */
+int ff_v4l2_enc_can_convert(enum AVPixelFormat src, enum AVPixelFormat dst);
+
+/**
+ * @return the OUTPUT format to ask the driver for when the frames are src:
+ *         src itself if V4L2 has a format for it, else one it converts to
+ */
+enum AVPixelFormat ff_v4l2_enc_request_fmt(enum AVPixelFormat src);
+
+/**
+ * Copy a software frame into the memory of a V4L2 OUTPUT buffer, laid out
+ * as the driver's format describes it, converting planar 4:2:0 frames to
+ * the semi-planar layout when the buffer is NV12, NV21 or P010.
+ *
+ * With one memory plane (single-planar NV12, P010, YUV420, ...) the planes
+ * are contiguous: plane 0 has bytesperline[0] bytes per line and fmt_height
+ * lines, the chroma planes follow at bytesperline[0] * fmt_height with the
+ * chroma line length the V4L2 specification derives from bytesperline[0].
+ * With several memory planes (NV12M, YUV420M, ...) every plane has its own
+ * memory and bytesperline.
+ *
+ * Only the frame's own lines and columns are read from it. When the format
+ * is larger than the frame (the driver rounded it up to whole macroblocks),
+ * the last column and line are repeated into the padding, which the encoder
+ * codes and the stream's cropping hides.
+ *
+ * @param src           the frame
+ * @param dst_fmt       the buffer's pixel format
+ * @param dst           base address of each memory plane
+ * @param dst_len       length of each memory plane
+ * @param bytesperline  bytesperline of each memory plane (0: tightly packed)
+ * @param nb_mem_planes number of memory planes
+ * @param fmt_width     the format's width
+ * @param fmt_height    the format's height
+ * @param bytesused     out: bytes used in each memory plane
+ * @return 0 on success, a negative AVERROR code otherwise
+ */
+int ff_v4l2_enc_copy_frame(const AVFrame *src, enum AVPixelFormat dst_fmt,
+                           uint8_t *const dst[], const size_t dst_len[],
+                           const int bytesperline[], int nb_mem_planes,
+                           int fmt_width, int fmt_height, size_t bytesused[]);
+
+/**
+ * Decode timestamps for an encoder that reorders (B frames).
+ *
+ * The device takes frames in presentation order and returns packets in
+ * decode order, each carrying its own frame's PTS. Packet n gets the PTS of
+ * the n - delay'th frame as its DTS, where delay bounds how far a frame
+ * moves forward in decode order (the number of B frames between
+ * references); the first delay packets get the first PTS minus whole frame
+ * durations. The DTS then rise strictly (as the input PTS do) and never
+ * exceed the packet's PTS.
+ */
+typedef struct V4L2EncTimestamps {
+    struct AVFifo *pts;    ///< PTS of the frames not yet used for a DTS
+    int delay;             ///< reorder delay, in frames
+    int64_t step;          ///< one frame duration, for the first delay DTS
+    int64_t nb_in;         ///< frames sent to the device
+    int64_t nb_out;        ///< packets received from it
+} V4L2EncTimestamps;
+
+/** (Re)initialize; ts must be zeroed before the first call. */
+int  ff_v4l2_enc_ts_init(V4L2EncTimestamps *ts, int delay, int64_t step);
+void ff_v4l2_enc_ts_uninit(V4L2EncTimestamps *ts);
+/** A frame with this PTS went to the device. */
+int  ff_v4l2_enc_ts_push(V4L2EncTimestamps *ts, int64_t pts);
+/** A packet came back: its DTS. */
+int  ff_v4l2_enc_ts_next_dts(V4L2EncTimestamps *ts, int64_t *dts);
+
+/** Frames sent to the device whose packets have not come back yet. */
+static inline int64_t ff_v4l2_enc_ts_in_flight(const V4L2EncTimestamps *ts)
+{
+    return ts->nb_in - ts->nb_out;
+}
+
+/**
+ * @return 1 if an H.264/HEVC Annex B buffer holds a coded picture (a VCL NAL
+ *         unit), 0 if it holds only headers (parameter sets, SEI); 1 for
+ *         other codecs
+ */
+int ff_v4l2_enc_has_picture(enum AVCodecID codec_id, const uint8_t *data, int size);
+
+/**
+ * Collect the parameter sets (H.264: SPS, PPS; HEVC: VPS, SPS, PPS) that
+ * precede the first picture of an Annex B packet, as Annex B extradata.
+ *
+ * @param out      out: the parameter sets, padded with
+ *                 AV_INPUT_BUFFER_PADDING_SIZE zero bytes; av_free() it
+ * @param out_size out: their size
+ * @return 0 on success, AVERROR_INVALIDDATA if a required one is missing
+ */
+int ff_v4l2_enc_extract_paramsets(enum AVCodecID codec_id, const uint8_t *data, int size,
+                                  uint8_t **out, int *out_size);
+
+#endif /* AVCODEC_V4L2_ENC_UTILS_H */
