+#include "libavcodec/v4l2_enc_utils.c"
+
+static int failures;
+
+#define CHECK(cond, ...) do {                                   \
+        if (!(cond)) {                                          \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            fprintf(stderr, __VA_ARGS__);                       \
+            fprintf(stderr, "\n");                              \
+            failures++;                                         \
+        }                                                       \
+    } while (0)
+
+/* A value that differs between planes, lines and columns. */
+static uint8_t pattern(int plane, int x, int y)
+{
+    return (uint8_t)(plane * 71 + x * 7 + y * 13 + (x * y >> 3));
+}
+
+static AVFrame *make_frame(enum AVPixelFormat fmt, int w, int h)
+{
+    AVFrame *f = av_frame_alloc();
+    int p, x, y, nb_planes = av_pix_fmt_count_planes(fmt);
+
+    if (!f)
+        return NULL;
+    f->format = fmt;
+    f->width  = w;
+    f->height = h;
+    /* a large alignment, so linesize != width */
+    if (av_frame_get_buffer(f, 128) < 0) {
+        av_frame_free(&f);
+        return NULL;
+    }
+    for (p = 0; p < nb_planes; p++) {
+        const AVPixFmtDescriptor *d = av_pix_fmt_desc_get(fmt);
+        int rows  = is_chroma_plane(p) ? AV_CEIL_RSHIFT(h, d->log2_chroma_h) : h;
+        int bytes = av_image_get_linesize(fmt, w, p);
+
+        for (y = 0; y < rows; y++)
+            for (x = 0; x < bytes; x++)
+                f->data[p][y * f->linesize[p] + x] = pattern(p, x, y);
+    }
+    return f;
+}
+
+/*
+ * Copy a w x h frame into a buffer whose format is fw x fh with the given
+ * bytesperline (one memory plane), and check every byte the encoder reads
+ * against a layout computed here independently:
+ * plane p starts at off[p] with stride[p] and has rows[p] lines.
+ */
+static void check_contiguous(const char *name, enum AVPixelFormat fmt,
+                             int w, int h, int fw, int fh, int bpl,
+                             const size_t off[], const int stride[],
+                             const int rows[], const int vis_rows[],
+                             const int bytes[], const int vis_bytes[],
+                             const int group[], size_t len)
+{
+    AVFrame *f = make_frame(fmt, w, h);
+    uint8_t *buf = av_mallocz(len);
+    uint8_t *dst[1] = { buf };
+    size_t dst_len[1] = { len }, used[1] = { 0 };
+    int p, x, y, ret, nb_planes = av_pix_fmt_count_planes(fmt);
+    int bad = 0;
+
+    if (!f || !buf) {
+        CHECK(0, "%s: out of memory", name);
+        goto end;
+    }
+    memset(buf, 0xEE, len);
+    ret = ff_v4l2_enc_copy_frame(f, fmt, dst, dst_len, &bpl, 1, fw, fh, used);
+    CHECK(ret == 0, "%s: copy returned %d", name, ret);
+    if (ret)
+        goto end;
+    CHECK(used[0] == off[nb_planes - 1] + (size_t)stride[nb_planes - 1] * rows[nb_planes - 1],
+          "%s: bytesused %zu", name, used[0]);
+
+    for (p = 0; p < nb_planes; p++) {
+        for (y = 0; y < rows[p] && bad < 10; y++) {
+            for (x = 0; x < bytes[p] && bad < 10; x++) {
+                int sx = x, sy = FFMIN(y, vis_rows[p] - 1);
+                uint8_t got = buf[off[p] + (size_t)y * stride[p] + x];
+
+                if (sx >= vis_bytes[p])     /* padded column: the last sample position */
+                    sx = vis_bytes[p] - group[p] + (x - vis_bytes[p]) % group[p];
+                if (got != pattern(p, sx, sy)) {
+                    CHECK(0, "%s: plane %d (%d,%d) = %d, want %d (source %d,%d)",
+                          name, p, x, y, got, pattern(p, sx, sy), sx, sy);
+                    bad++;
+                }
+            }
+        }
+    }
+    /* nothing written past the last plane */
+    for (x = (int)used[0]; x < (int)len && x < (int)used[0] + 64; x++)
+        if (buf[x] != 0xEE) {
+            CHECK(0, "%s: wrote past bytesused at %d", name, x);
+            break;
+        }
+end:
+    av_frame_free(&f);
+    av_free(buf);
+}
+
+static void test_copy(void)
+{
+    /* SD: 720 wide, the driver's bytesperline is 768 (64-aligned) */
+    {
+        const size_t off[]    = { 0, 768 * 576 };
+        const int stride[]    = { 768, 768 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 720, 720 }, vis_bytes[] = { 720, 720 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 720x576 bpl 768", AV_PIX_FMT_NV12, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 * 3 / 2);
+    }
+    /* 1080 lines: the driver rounds the height to 1088 */
+    {
+        const size_t off[]    = { 0, 1920 * 1088 };
+        const int stride[]    = { 1920, 1920 };
+        const int rows[]      = { 1088, 544 }, vis_rows[] = { 1080, 540 };
+        const int bytes[]     = { 1920, 1920 }, vis_bytes[] = { 1920, 1920 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 1920x1080 in 1920x1088", AV_PIX_FMT_NV12, 1920, 1080,
+                         1920, 1088, 1920, off, stride, rows, vis_rows, bytes,
+                         vis_bytes, group, 1920 * 1088 * 3 / 2);
+    }
+    /* HEVC sizing: chroma still at bytesperline * height, slack after it */
+    {
+        const size_t off[]    = { 0, 768 * 576 };
+        const int stride[]    = { 768, 768 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 720, 720 }, vis_bytes[] = { 720, 720 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 720x576 hevc slack", AV_PIX_FMT_NV12, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 + 768 * (FFALIGN(576, 64) / 2));
+    }
+    /* width and height both padded: 1916x1078 in 1920x1088 */
+    {
+        const size_t off[]    = { 0, 1984 * 1088 };
+        const int stride[]    = { 1984, 1984 };
+        const int rows[]      = { 1088, 544 }, vis_rows[] = { 1078, 539 };
+        const int bytes[]     = { 1920, 1920 }, vis_bytes[] = { 1916, 1916 };
+        const int group[]     = { 1, 2 };
+        check_contiguous("nv12 1916x1078 in 1920x1088", AV_PIX_FMT_NV12, 1916, 1078,
+                         1920, 1088, 1984, off, stride, rows, vis_rows, bytes,
+                         vis_bytes, group, 1984 * 1088 * 3 / 2);
+    }
+    /* P010: two bytes a sample */
+    {
+        const size_t off[]    = { 0, 1536 * 576 };
+        const int stride[]    = { 1536, 1536 };
+        const int rows[]      = { 576, 288 }, vis_rows[] = { 576, 288 };
+        const int bytes[]     = { 1440, 1440 }, vis_bytes[] = { 1440, 1440 };
+        const int group[]     = { 2, 4 };
+        check_contiguous("p010 720x576 bpl 1536", AV_PIX_FMT_P010LE, 720, 576, 720, 576,
+                         1536, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         1536 * 576 * 3 / 2);
+    }
+    /* single-planar YUV420 (I420): chroma lines are half of bytesperline */
+    {
+        const size_t off[]    = { 0, 768 * 576, 768 * 576 + 384 * 288 };
+        const int stride[]    = { 768, 384, 384 };
+        const int rows[]      = { 576, 288, 288 }, vis_rows[] = { 576, 288, 288 };
+        const int bytes[]     = { 720, 360, 360 }, vis_bytes[] = { 720, 360, 360 };
+        const int group[]     = { 1, 1, 1 };
+        check_contiguous("yuv420p 720x576 bpl 768", AV_PIX_FMT_YUV420P, 720, 576, 720, 576,
+                         768, off, stride, rows, vis_rows, bytes, vis_bytes, group,
+                         768 * 576 * 3 / 2);
+    }
+
+    /* a buffer too small is refused, not overrun */
+    {
+        AVFrame *f = make_frame(AV_PIX_FMT_NV12, 720, 576);
+        size_t len = 768 * 576, used[1];
+        uint8_t *buf = av_malloc(len), *dst[1] = { buf };
+        int bpl = 768;
+
+        CHECK(f && buf, "oom");
+        if (f && buf)
+            CHECK(ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, &len, &bpl, 1,
+                                         720, 576, used) == AVERROR(ENOSPC),
+                  "short buffer accepted");
+        av_frame_free(&f);
+        av_free(buf);
+    }
+
+    /* two memory planes (NV12M), each with its own bytesperline */
+    {
+        AVFrame *f = make_frame(AV_PIX_FMT_NV12, 720, 576);
+        size_t len[2] = { 768 * 576, 832 * 288 }, used[2] = { 0 };
+        uint8_t *y = av_mallocz(len[0]), *uv = av_mallocz(len[1]);
+        uint8_t *dst[2] = { y, uv };
+        int bpl[2] = { 768, 832 }, ret, i, bad = 0;
+
+        if (f && y && uv) {
+            ret = ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, len, bpl, 2,
+                                         720, 576, used);
+            CHECK(ret == 0 && used[0] == len[0] && used[1] == len[1],
+                  "nv12m: ret %d used %zu %zu", ret, used[0], used[1]);
+            for (i = 0; i < 720 * 576 && !bad; i++)
+                bad |= y[(i / 720) * 768 + i % 720] != pattern(0, i % 720, i / 720);
+            for (i = 0; i < 720 * 288 && !bad; i++)
+                bad |= uv[(i / 720) * 832 + i % 720] != pattern(1, i % 720, i / 720);
+            CHECK(!bad, "nv12m: wrong sample");
+        } else
+            CHECK(0, "oom");
+        av_frame_free(&f);
+        av_free(y);
+        av_free(uv);
+    }
+}
+
+/* yuv420p -> NV12 and yuv420p10 -> P010 while copying, with padding */
+static void test_convert(void)
+{
+    const int w = 718, h = 574, fw = 720, fh = 576, bpl = 768;
+    AVFrame *f = make_frame(AV_PIX_FMT_YUV420P, w, h);
+    size_t len = (size_t)bpl * fh * 3 / 2, used[1];
+    uint8_t *buf = av_mallocz(len), *dst[1] = { buf };
+    int x, y, bad = 0, b = bpl;
+
+    CHECK(ff_v4l2_enc_can_convert(AV_PIX_FMT_YUV420P, AV_PIX_FMT_NV12), "can_convert");
+    CHECK(!ff_v4l2_enc_can_convert(AV_PIX_FMT_YUV422P, AV_PIX_FMT_NV12), "can_convert 422");
+    CHECK(ff_v4l2_enc_request_fmt(AV_PIX_FMT_YUV420P10LE) == AV_PIX_FMT_P010LE, "request_fmt");
+
+    if (!f || !buf) {
+        CHECK(0, "oom");
+        goto p010;
+    }
+    CHECK(!ff_v4l2_enc_copy_frame(f, AV_PIX_FMT_NV12, dst, &len, &b, 1, fw, fh, used),
+          "yuv420p->nv12 failed");
+    for (y = 0; y < fh && bad < 5; y++)
+        for (x = 0; x < fw && bad < 5; x++) {
+            int sx = FFMIN(x, w - 1), sy = FFMIN(y, h - 1);
+            if (buf[y * bpl + x] != pattern(0, sx, sy)) {
+                CHECK(0, "nv12 Y (%d,%d)", x, y);
+                bad++;
+            }
+        }
+    for (y = 0; y < fh / 2 && bad < 5; y++)
+        for (x = 0; x < fw / 2 && bad < 5; x++) {
+            int sx = FFMIN(x, w / 2 - 1), sy = FFMIN(y, h / 2 - 1);
+            const uint8_t *uv = buf + bpl * fh + y * bpl + 2 * x;
+            if (uv[0] != pattern(1, sx, sy) || uv[1] != pattern(2, sx, sy)) {
+                CHECK(0, "nv12 UV (%d,%d): %d %d want %d %d", x, y, uv[0], uv[1],
+                      pattern(1, sx, sy), pattern(2, sx, sy));
+                bad++;
+            }
+        }
+
+p010:
+    av_frame_free(&f);
+    av_free(buf);
+
+    /* yuv420p10 -> P010 */
+    {
+        const int pw = 720, ph = 576, pbpl = 1536;
+        AVFrame *g = av_frame_alloc();
+        size_t plen = (size_t)pbpl * ph * 3 / 2;
+        uint8_t *pbuf = av_mallocz(plen), *pdst[1] = { pbuf };
+        int pb = pbpl;
+
+        if (!g || !pbuf)
+            goto end;
+        g->format = AV_PIX_FMT_YUV420P10LE;
+        g->width  = pw;
+        g->height = ph;
+        if (av_frame_get_buffer(g, 64) < 0)
+            goto end;
+        for (y = 0; y < ph; y++)
+            for (x = 0; x < pw; x++)
+                AV_WL16(g->data[0] + y * g->linesize[0] + 2 * x, (x * 3 + y) & 1023);
+        for (y = 0; y < ph / 2; y++)
+            for (x = 0; x < pw / 2; x++) {
+                AV_WL16(g->data[1] + y * g->linesize[1] + 2 * x, (x + 5 * y) & 1023);
+                AV_WL16(g->data[2] + y * g->linesize[2] + 2 * x, (7 * x + y) & 1023);
+            }
+        CHECK(!ff_v4l2_enc_copy_frame(g, AV_PIX_FMT_P010LE, pdst, &plen, &pb, 1, pw, ph, used),
+              "yuv420p10->p010 failed");
+        bad = 0;
+        for (y = 0; y < ph && !bad; y++)
+            for (x = 0; x < pw && !bad; x++)
+                bad |= AV_RL16(pbuf + y * pbpl + 2 * x) != (((x * 3 + y) & 1023) << 6);
+        for (y = 0; y < ph / 2 && !bad; y++)
+            for (x = 0; x < pw / 2 && !bad; x++) {
+                const uint8_t *uv = pbuf + pbpl * ph + y * pbpl + 4 * x;
+                bad |= AV_RL16(uv)     != (((x + 5 * y) & 1023) << 6) ||
+                       AV_RL16(uv + 2) != (((7 * x + y) & 1023) << 6);
+            }
+        CHECK(!bad, "p010 sample wrong at (%d,%d)", x, y);
+end:
+        av_frame_free(&g);
+        av_free(pbuf);
+    }
+}
+
+/*
+ * An emulation of a reordering encoder: the B-frame planner of the Apple AVE
+ * V4L2 driver (ave_gop.h), fed frames in presentation order. It holds up to
+ * nb frames as B frames until their anchor (a P) arrives, then codes the
+ * group anchor first; an IDR (the first frame, every gop frames) first
+ * closes the held frames as Bs + a P. With know_last the driver learns
+ * which frame is the last when it arrives (the last is an anchor);
+ * otherwise the drain closes what it holds. order[] gets each group's
+ * frames in decode order; shuffle permutes every group at random instead,
+ * which the DTS must also survive.
+ */
+typedef struct Emu {
+    int nb, gop, know_last, shuffle;
+    int held[8], n_held, dist, started;
+    int order[4096], n_order;
+    int groups[4096], n_groups;  /* order index where each group ends */
+    unsigned rnd;
+} Emu;
+
+static unsigned emu_rand(Emu *e)
+{
+    e->rnd = e->rnd * 1664525u + 1013904223u;
+    return e->rnd >> 8;
+}
+
+static void emu_group(Emu *e, const int *frames, int n)
+{
+    int i, start = e->n_order;
+
+    for (i = 0; i < n; i++)
+        e->order[e->n_order++] = frames[i];
+    if (e->shuffle) {
+        for (i = n - 1; i > 0; i--) {
+            int j = emu_rand(e) % (i + 1), t = e->order[start + i];
+            e->order[start + i] = e->order[start + j];
+            e->order[start + j] = t;
+        }
+    }
+    e->groups[e->n_groups++] = e->n_order;
+}
+
+/* held Bs and their P: the P (the newest) first, then the Bs */
+static void emu_close(Emu *e, int with_new, int new_frame)
+{
+    int g[8], n = 0, i;
+
+    if (with_new) {
+        g[n++] = new_frame;
+        for (i = 0; i < e->n_held; i++)
+            g[n++] = e->held[i];
+    } else if (e->n_held) {
+        g[n++] = e->held[e->n_held - 1];
+        for (i = 0; i < e->n_held - 1; i++)
+            g[n++] = e->held[i];
+    }
+    if (n)
+        emu_group(e, g, n);
+    e->n_held = 0;
+}
+
+static void emu_frame(Emu *e, int f, int last)
+{
+    if (!e->started || (e->gop && e->dist >= e->gop)) {
+        emu_close(e, 0, 0);
+        emu_group(e, &f, 1);              /* the IDR, alone */
+        e->started = 1;
+        e->dist = 1;
+    } else if ((last && e->know_last) || e->n_held >= e->nb ||
+               (e->gop && e->dist + 1 >= e->gop)) {
+        emu_close(e, 1, f);
+        e->dist++;
+    } else {
+        e->held[e->n_held++] = f;
+        e->dist++;
+    }
+}
+
+/*
+ * Run n frames through the emulation and the DTS derivation; return the
+ * number of packets whose DTS is above their PTS or not above the previous
+ * DTS (reported unless quiet), or -1 on a bookkeeping failure.
+ */
+static int run_dts(int nb, int delay, int gop, int n, int know_last, int shuffle,
+                   int vfr, int64_t start, int quiet)
+{
+    Emu e = { .nb = nb, .gop = gop, .know_last = know_last, .shuffle = shuffle,
+              .rnd = 12345u + n * 7u + gop };
+    V4L2EncTimestamps ts = { 0 };
+    int64_t pts[4096], prev_dts = INT64_MIN;
+    int i, g = 0, out = 0, bad = 0;
+
+    pts[0] = start;
+    for (i = 1; i < n; i++)
+        pts[i] = pts[i - 1] + (vfr ? 1 + emu_rand(&e) % 5 : 3);
+
+    if (ff_v4l2_enc_ts_init(&ts, delay, 3) < 0)
+        return -1;
+    for (i = 0; i < n; i++) {
+        emu_frame(&e, i, i == n - 1);
+        if (i == n - 1)
+            emu_close(&e, 0, 0);          /* the drain */
+        if (ff_v4l2_enc_ts_push(&ts, pts[i]) < 0)
+            goto fail;
+        /* the packets of every group complete so far come back now */
+        for (; g < e.n_groups; g++) {
+            for (; out < e.groups[g]; out++) {
+                int64_t dts, p = pts[e.order[out]];
+
+                if (ff_v4l2_enc_ts_next_dts(&ts, &dts) < 0)
+                    goto fail;
+                if (dts > p || dts <= prev_dts || (!delay && dts != p)) {
+                    if (!quiet && bad < 3)
+                        CHECK(0, "nb %d delay %d gop %d n %d last %d shuffle %d: packet %d "
+                              "(frame %d) PTS %"PRId64" DTS %"PRId64" previous DTS %"PRId64,
+                              nb, delay, gop, n, know_last, shuffle, out, e.order[out],
+                              p, dts, prev_dts);
+                    bad++;
+                }
+                prev_dts = dts;
+            }
+        }
+        /* never more than the held B frames in flight */
+        if (ff_v4l2_enc_ts_in_flight(&ts) > nb)
+            goto fail;
+    }
+    if (out != n || ff_v4l2_enc_ts_in_flight(&ts))
+        goto fail;
+    ff_v4l2_enc_ts_uninit(&ts);
+    return bad;
+fail:
+    ff_v4l2_enc_ts_uninit(&ts);
+    return -1;
+}
+
+static void test_dts(void)
+{
+    static const int gops[]     = { 0, 1, 2, 3, 4, 5, 12, 250 };
+    static const int counts[]   = { 1, 2, 3, 4, 7, 60, 1000 };
+    static const int64_t starts[] = { 0, -7, 90000 };
+    int nb, gi, ci, si, last, shuffle, vfr, ret, control = 0;
+
+    for (nb = 0; nb <= 2; nb++)
+        for (gi = 0; gi < FF_ARRAY_ELEMS(gops); gi++)
+            for (ci = 0; ci < FF_ARRAY_ELEMS(counts); ci++)
+                for (last = 0; last <= 1; last++)
+                    for (shuffle = 0; shuffle <= 1; shuffle++)
+                        for (vfr = 0; vfr <= 1; vfr++) {
+                            for (si = 0; si < FF_ARRAY_ELEMS(starts); si++) {
+                                ret = run_dts(nb, nb, gops[gi], counts[ci], last,
+                                              shuffle, vfr, starts[si], 0);
+                                CHECK(ret == 0, "nb %d gop %d n %d: %d bad DTS",
+                                      nb, gops[gi], counts[ci], ret);
+                            }
+                            /* the driver may code fewer B frames than it accepted */
+                            ret = run_dts(nb, 2, gops[gi], counts[ci], last,
+                                          shuffle, vfr, 0, 0);
+                            CHECK(ret == 0, "nb %d delay 2: %d bad DTS", nb, ret);
+                            /* control: B frames without a reorder delay must fail
+                             * (unshuffled: a shuffle may put a group back in order) */
+                            if (nb && !shuffle && counts[ci] >= 7 && gops[gi] != 1 && gops[gi] != 2) {
+                                ret = run_dts(nb, 0, gops[gi], counts[ci], last,
+                                              shuffle, vfr, 0, 1);
+                                CHECK(ret > 0, "control passed: nb %d delay 0 gop %d n %d",
+                                      nb, gops[gi], counts[ci]);
+                                control++;
+                            }
+                        }
+    CHECK(control > 0, "no control ran");
+
+    /* delay 1 is exact for anchor-first groups (x264's has_b_frames without pyramid) */
+    for (nb = 1; nb <= 2; nb++) {
+        ret = run_dts(nb, 1, 250, 1000, 0, 0, 0, 0, 0);
+        CHECK(ret == 0, "nb %d delay 1, anchor first: %d bad DTS", nb, ret);
+    }
+
+    /* the exact sequence for B=1: I0 P2 B1 P4 B3 ... */
+    {
+        V4L2EncTimestamps ts = { 0 };
+        static const int order[] = { 0, 2, 1, 4, 3, 5 };
+        static const int64_t want[] = { -1, 0, 1, 2, 3, 4 };
+        int64_t dts;
+        int i;
+
+        ff_v4l2_enc_ts_init(&ts, 1, 1);
+        for (i = 0; i < 6; i++)
+            ff_v4l2_enc_ts_push(&ts, i);
+        for (i = 0; i < 6; i++) {
+            ff_v4l2_enc_ts_next_dts(&ts, &dts);
+            CHECK(dts == want[i] && dts <= order[i], "B=1 packet %d: DTS %"PRId64, i, dts);
+        }
+        ff_v4l2_enc_ts_uninit(&ts);
+    }
+}
+
+static void test_has_picture(void)
+{
+    static const uint8_t h264_hdr[] = { 0, 0, 0, 1, 0x67, 0x64, 0x00, 0x28, 0, 0, 1, 0x68, 0xee, 0x3c, 0x80 };
+    static const uint8_t h264_idr[] = { 0, 0, 0, 1, 0x67, 0x64, 0, 0, 0, 1, 0x68, 0xee,
+                                        0, 0, 1, 0x65, 0x88, 0x84, 0x00 };
+    static const uint8_t h264_b[]   = { 0, 0, 0, 1, 0x01, 0x9e, 0x12 };
+    static const uint8_t hevc_hdr[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0, 0, 0, 1, 0x42, 0x01, 0x01,
+                                        0, 0, 0, 1, 0x44, 0x01, 0xc1, 0, 0, 0, 1, 0x4e, 0x01, 0x05 };
+    static const uint8_t hevc_idr[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0, 0, 0, 1, 0x26, 0x01, 0xaf };
+    static const uint8_t hevc_trail[] = { 0, 0, 1, 0x02, 0x01, 0xd0, 0x00, 0x00 };
+
+    CHECK(!ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_hdr, sizeof(h264_hdr)), "h264 hdr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_idr, sizeof(h264_idr)), "h264 idr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_H264, h264_b, sizeof(h264_b)), "h264 b");
+    CHECK(!ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_hdr, sizeof(hevc_hdr)), "hevc hdr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_idr, sizeof(hevc_idr)), "hevc idr");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_HEVC, hevc_trail, sizeof(hevc_trail)), "hevc trail");
+    CHECK(ff_v4l2_enc_has_picture(AV_CODEC_ID_VP8, h264_hdr, sizeof(h264_hdr)), "vp8");
+
+}
+
+static void test_paramsets(void)
+{
+    /* AUD, SPS, PPS, SEI, IDR slice; 3- and 4-byte start codes, trailing zeros */
+    static const uint8_t h264[] = { 0, 0, 0, 1, 0x09, 0x10,
+                                    0, 0, 0, 1, 0x67, 0x64, 0x00, 0x28, 0xac, 0x00,
+                                    0, 0, 1, 0x68, 0xee, 0x3c, 0x80,
+                                    0, 0, 1, 0x06, 0x05, 0x01, 0x80,
+                                    0, 0, 1, 0x65, 0x88, 0x84, 0x00, 0x21 };
+    static const uint8_t h264_want[] = { 0, 0, 0, 1, 0x67, 0x64, 0x00, 0x28, 0xac,
+                                         0, 0, 0, 1, 0x68, 0xee, 0x3c, 0x80 };
+    /* VPS, SPS, PPS, prefix SEI, IDR_W_RADL; an SPS-like byte pattern in the slice */
+    static const uint8_t hevc[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0x01,
+                                    0, 0, 0, 1, 0x42, 0x01, 0x01, 0x01,
+                                    0, 0, 0, 1, 0x44, 0x01, 0xc1, 0x72,
+                                    0, 0, 0, 1, 0x4e, 0x01, 0x05, 0xff,
+                                    0, 0, 0, 1, 0x26, 0x01, 0xaf, 0x00, 0x00, 0x03, 0x42 };
+    static const uint8_t hevc_want[] = { 0, 0, 0, 1, 0x40, 0x01, 0x0c, 0x01,
+                                         0, 0, 0, 1, 0x42, 0x01, 0x01, 0x01,
+                                         0, 0, 0, 1, 0x44, 0x01, 0xc1, 0x72 };
+    static const uint8_t no_pps[] = { 0, 0, 0, 1, 0x67, 0x64, 0, 0, 1, 0x65, 0x88 };
+    uint8_t *out = NULL;
+    int size = 0, ret, i, pad = 1;
+
+    ret = ff_v4l2_enc_extract_paramsets(AV_CODEC_ID_H264, h264, sizeof(h264), &out, &size);
+    CHECK(ret == 0 && size == sizeof(h264_want) && !memcmp(out, h264_want, size),
+          "h264 parameter sets: ret %d size %d", ret, size);
+    for (i = 0; ret == 0 && i < AV_INPUT_BUFFER_PADDING_SIZE; i++)
+        pad &= !out[size + i];
+    CHECK(pad, "h264 extradata padding");
+    av_freep(&out);
+
+    ret = ff_v4l2_enc_extract_paramsets(AV_CODEC_ID_HEVC, hevc, sizeof(hevc), &out, &size);
+    CHECK(ret == 0 && size == sizeof(hevc_want) && !memcmp(out, hevc_want, size),
+          "hevc parameter sets: ret %d size %d", ret, size);
+    av_freep(&out);
+
+    ret = ff_v4l2_enc_extract_paramsets(AV_CODEC_ID_H264, no_pps, sizeof(no_pps), &out, &size);
+    CHECK(ret == AVERROR_INVALIDDATA && !out, "h264 without a PPS: ret %d", ret);
+    /* the HEVC stream has no H.264 SPS/PPS: control */
+    ret = ff_v4l2_enc_extract_paramsets(AV_CODEC_ID_H264, hevc, sizeof(hevc), &out, &size);
+    CHECK(ret == AVERROR_INVALIDDATA, "hevc data as h264: ret %d", ret);
+    av_freep(&out);
+}
+
+int main(void)
+{
+    test_paramsets();
+    test_copy();
+    test_convert();
+    test_dts();
+    test_has_picture();
+
+    if (failures) {
+        fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
+    printf("v4l2_enc_utils: all tests passed\n");
+    return 0;
+}
