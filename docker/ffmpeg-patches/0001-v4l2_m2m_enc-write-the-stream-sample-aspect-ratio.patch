+static const uint8_t *v4l2_find_startcode(const uint8_t *p, const uint8_t *end)
+{
+    while (p + 3 <= end) {
+        if (!p[0] && !p[1] && p[2] == 1)
+            return p + 3;
+        p++;
+    }
+    return NULL;
+}
+
+/* The sample aspect ratio lives in the VUI of the SPS and nowhere else. */
+static int v4l2_has_sps(enum AVCodecID codec_id, const uint8_t *data, int size)
+{
+    const uint8_t *end = data + size;
+    const uint8_t *nal = v4l2_find_startcode(data, end);
+    const int hevc = codec_id == AV_CODEC_ID_HEVC;
+
+    while (nal && nal < end) {
+        if (((nal[0] >> hevc) & (hevc ? 0x3f : 0x1f)) == (hevc ? 33 : 7))
+            return 1;
+        nal = v4l2_find_startcode(nal, end);
+    }
+    return 0;
+}
+
+/*
+ * The device's parameter sets carry no VUI sample aspect ratio, so a decoder
+ * assumes square pixels and an anamorphic stream (ISDB's 1440x1080) plays as
+ * 4:3. h264_metadata/hevc_metadata rewrite them in place with the ratio the
+ * encoder was given, so nothing is left for the caller to add.
+ */
+static int v4l2_init_sar_bsf(V4L2m2mContext *s)
+{
+    AVCodecContext *avctx = s->avctx;
+    const AVBitStreamFilter *filter;
+    AVRational sar = avctx->sample_aspect_ratio;
+    const char *name;
+    int ret;
+
+    if (sar.num <= 0 || sar.den <= 0 || sar.num == sar.den)
+        return 0;
+    if (avctx->codec_id != AV_CODEC_ID_H264 && avctx->codec_id != AV_CODEC_ID_HEVC)
+        return 0;
+
+    name   = avctx->codec_id == AV_CODEC_ID_H264 ? "h264_metadata" : "hevc_metadata";
+    filter = av_bsf_get_by_name(name);
+    if (!filter) {
+        av_log(avctx, AV_LOG_WARNING, "No %s bitstream filter: the stream carries "
+               "no aspect ratio\n", name);
+        return 0;
+    }
+
+    ret = av_bsf_alloc(filter, &s->sar_bsf);
+    if (ret < 0)
+        return ret;
+    s->sar_bsf->par_in->codec_id = avctx->codec_id;
+    s->sar_bsf->par_in->width    = avctx->width;
+    s->sar_bsf->par_in->height   = avctx->height;
+    ret = av_opt_set_q(s->sar_bsf->priv_data, "sample_aspect_ratio", sar, 0);
+    if (!ret)
+        ret = av_bsf_init(s->sar_bsf);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Cannot write the aspect ratio %d:%d: %s\n",
+               sar.num, sar.den, av_err2str(ret));
+        av_bsf_free(&s->sar_bsf);
+        return 0;
+    }
+
+    av_log(avctx, AV_LOG_VERBOSE, "Writing aspect ratio %d:%d into the parameter sets\n",
+           sar.num, sar.den);
+    return 0;
+}
+
+/*
+ * Only an access unit that carries an SPS has the VUI to rewrite; the rest
+ * of the stream stays byte-identical to what the device coded. One access
+ * unit in, one out: this wrapper has no drain path, so a packet the filter
+ * kept back could only ever surface as a stuck stream.
+ */
+static int v4l2_filter_sar(AVCodecContext *avctx, V4L2m2mContext *s, AVPacket *pkt)
+{
+    int ret;
+
+    if (!s->sar_bsf || !pkt->size)
+        return 0;
+    if (!v4l2_has_sps(avctx->codec_id, pkt->data, pkt->size))
+        return 0;
+    ret = av_bsf_send_packet(s->sar_bsf, pkt);
+    if (ret < 0)
+        return ret == AVERROR(EAGAIN) ? AVERROR_BUG : ret;
+    ret = av_bsf_receive_packet(s->sar_bsf, pkt);
+    return ret == AVERROR(EAGAIN) ? AVERROR_BUG : ret;
+}
+
 static int v4l2_receive_packet(AVCodecContext *avctx, AVPacket *avpkt)
 {
     V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
